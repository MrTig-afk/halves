# Halves - every variable the server reads. Copy to .env and fill in.
# All are server-only: none may be prefixed NEXT_PUBLIC_ (PRD 10.2).

# Neon Postgres, project "halves" - app role (halves_app), pooled
DATABASE_URL=postgres://app_user:password@host/halves?sslmode=require
# Neon Postgres, project "halves" - owner role, used only by migrations
MIGRATION_DATABASE_URL=postgres://owner:password@host/halves?sslmode=require

# Google Gemini API key, free tier (aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key

# Web Push (VAPID) key pair - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Signs the session cookie; 32+ random bytes, base64
SESSION_SECRET=generate-with-openssl-rand-base64-32

# First-deploy seed (PRD 6.1): the admin tile gets this PIN; partner tile is unclaimed
ADMIN_NAME=Kaushik
ADMIN_EMAIL=you@example.com
ADMIN_INITIAL_PIN=0000
PARTNER_NAME=Partner
